---
// src/pages/projets/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

// 1. Définir les routes générées statiquement au moment du build
export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((projet) => ({
    params: { slug: projet.slug },
    props: { projet },
  }));
}

// 2. Récupérer les données pour la page actuelle
const { projet } = Astro.props;
const { Content } = await projet.render(); // Rendu du contenu MDX
---

<BaseLayout title={projet.data.title} description={projet.data.description}>
  <article class="max-w-3xl mx-auto">
    <!-- En-tête de l'article -->
    <header class="mb-8 pb-8 border-b border-slate-200">
      <div class="flex flex-wrap gap-2 mb-4">
        {projet.data.tags.map((tag) => (
          <span class="px-3 py-1 text-sm font-medium bg-blue-100 text-blue-800 rounded-full">
            {tag}
          </span>
        ))}
      </div>
      
      <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
        {projet.data.title}
      </h1>
      
      <div class="flex items-center gap-4 text-sm text-slate-500">
        <time datetime={projet.data.date.toISOString()}>
          {projet.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span>•</span>
        <span>Lecture : ~3 min</span>
      </div>
    </header>

    <!-- Contenu MDX rendu -->
    <div class="prose prose-slate prose-lg max-w-none 
                prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline
                prose-headings:font-bold prose-headings:text-slate-900
                prose-blockquote:border-l-4 prose-blockquote:border-blue-500 prose-blockquote:bg-slate-50 prose-blockquote:p-4 prose-blockquote:rounded-r-lg">
      <Content />
    </div>

    <!-- Liens de fin d'article -->
    <footer class="mt-12 pt-8 border-t border-slate-200 flex gap-4">
      {projet.data.demoUrl && (
        <a href={projet.data.demoUrl} target="_blank" rel="noopener noreferrer" 
           class="px-5 py-2.5 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors">
          Voir la démo ↗
        </a>
      )}
      {projet.data.repoUrl && (
        <a href={projet.data.repoUrl} target="_blank" rel="noopener noreferrer" 
           class="px-5 py-2.5 border border-slate-300 text-slate-700 font-medium rounded-lg hover:bg-slate-50 transition-colors">
          Voir le code (GitHub) ↗
        </a>
      )}
    </footer>
    
    <div class="mt-8">
      <a href="/projets" class="text-blue-600 hover:underline font-medium">← Retour aux projets</a>
    </div>
  </article>
</BaseLayout>