---
// src/pages/a-propos.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import StatutActuel from '../components/StatutActuel.tsx';

const competences = {
  frontend: ["React", "Next.js", "Astro", "TypeScript", "Tailwind CSS", "Vue.js"],
  backend: ["Node.js", "NestJS", "PostgreSQL", "Prisma", "GraphQL", "Redis"],
  devops: ["Docker", "CI/CD (GitHub Actions)", "Vercel", "AWS (S3, Lambda)", "Linux"]
};

const philosophies = [
  {
    titre: "Performance par défaut",
    desc: "Je ne considère pas l'optimisation comme une étape finale, mais comme un fondement. Chaque octet de JS envoyé au client doit être justifié."
  },
  {
    titre: "Dette technique maîtrisée",
    desc: "J'écris du code pour qu'il soit lu par des humains, pas seulement exécuté par des machines. Tests, typage strict et documentation font partie de la définition de 'fini'."
  },
  {
    titre: "Impact Business",
    desc: "La technologie est un moyen, pas une fin. Je m'assure toujours que les choix d'architecture servent les objectifs métier et l'expérience utilisateur finale."
  }
];
---

<BaseLayout title="À propos | Portfolio Senior JS">
  <article class="max-w-4xl mx-auto space-y-16">
    
    <!-- Section 1 : Introduction & Statut -->
    <section class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
      <div class="flex-1">
        <h1 class="text-4xl font-bold text-slate-900 mb-6">Plus qu'un codeur, un partenaire technique.</h1>
        <p class="text-lg text-slate-600 leading-relaxed mb-4">
          Avec plus de 7 ans d'expérience dans l'écosystème JavaScript, j'ai évolué du développement de fonctionnalités isolées à la conception d'architectures complètes. 
        </p>
        <p class="text-lg text-slate-600 leading-relaxed">
          Aujourd'hui, mon rôle est de faire le pont entre les besoins métier et l'excellence technique, tout en montant en compétence les équipes avec qui je travaille.
        </p>
      </div>
      
      <!-- Composant React hydraté uniquement quand nécessaire -->
      <div class="md:mt-2">
        <StatutActuel client:load />
      </div>
    </section>

    <!-- Section 2 : Stack Technique (Catégorisée) -->
    <section>
      <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span class="text-blue-600">⚡</span> Stack Technique
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 bg-white rounded-xl border border-slate-200 shadow-sm">
          <h3 class="font-semibold text-slate-900 mb-3">Frontend</h3>
          <div class="flex flex-wrap gap-2">
            {competences.frontend.map(tech => (
              <span class="px-3 py-1 text-sm bg-blue-50 text-blue-700 rounded-md font-medium">{tech}</span>
            ))}
          </div>
        </div>
        <div class="p-5 bg-white rounded-xl border border-slate-200 shadow-sm">
          <h3 class="font-semibold text-slate-900 mb-3">Backend & Data</h3>
          <div class="flex flex-wrap gap-2">
            {competences.backend.map(tech => (
              <span class="px-3 py-1 text-sm bg-emerald-50 text-emerald-700 rounded-md font-medium">{tech}</span>
            ))}
          </div>
        </div>
        <div class="p-5 bg-white rounded-xl border border-slate-200 shadow-sm">
          <h3 class="font-semibold text-slate-900 mb-3">DevOps & Outils</h3>
          <div class="flex flex-wrap gap-2">
            {competences.devops.map(tech => (
              <span class="px-3 py-1 text-sm bg-purple-50 text-purple-700 rounded-md font-medium">{tech}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3 : Philosophie de travail -->
    <section>
      <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
        <span class="text-blue-600">🧠</span> Philosophie de travail
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {philosophies.map((item) => (
          <div class="p-6 bg-slate-50 rounded-xl border border-slate-100">
            <h3 class="font-bold text-slate-900 mb-2">{item.titre}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 4 : Call to Action -->
    <section class="text-center py-8 bg-blue-600 text-white rounded-2xl px-6">
      <h2 class="text-2xl font-bold mb-4">Un projet ou un défi technique en tête ?</h2>
      <p class="text-blue-100 mb-8 max-w-xl mx-auto">
        Que ce soit pour auditer une architecture, développer une fonctionnalité critique ou accompagner une équipe, discutons-en.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="mailto:votre.email@exemple.com" class="px-6 py-3 bg-white text-blue-600 font-bold rounded-lg hover:bg-blue-50 transition-colors">
          Me contacter par email
        </a>
        <a href="/cv.pdf" target="_blank" class="px-6 py-3 border-2 border-white text-white font-bold rounded-lg hover:bg-white/10 transition-colors">
          Télécharger mon CV (PDF)
        </a>
      </div>
    </section>

  </article>
</BaseLayout>