---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Accueil | MARA - Développeur Full Stack" fullWidth={true}>
  
  <!-- Section Hero plein écran avec fond teal -->
  <div class="min-h-screen bg-gradient-to-br from-[#022c22] via-[#064e3b] to-[#0f766e]">
    
    <div class="min-h-screen flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 py-20">
      
      <!-- Badge de statut -->
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-md border border-white/20 rounded-full mb-8 animate-fade-in-up">
        <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
        <span class="text-emerald-100 text-sm font-medium">Disponible pour de nouveaux projets</span>
      </div>

      <!-- Titre principal -->
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-white mb-6 text-center animate-fade-in-up">
        Développeur Senior <span class="text-emerald-400">JavaScript</span>
      </h1>
      
      <!-- Sous-titre -->
      <p class="text-xl md:text-2xl text-emerald-100 max-w-3xl text-center mb-12 leading-relaxed animate-fade-in-up">
        Je conçois des architectures web performantes, maintenables et centrées sur l'utilisateur. 
        Spécialisé en React, Node.js et optimisation des Core Web Vitals.
      </p>
      
      <!-- Boutons d'action -->
      <div class="flex flex-col sm:flex-row gap-4 mb-20 animate-fade-in-up">
        <a href="/projets" class="px-8 py-4 bg-white text-[#064e3b] font-bold rounded-xl hover:bg-emerald-50 transition-all duration-300 shadow-2xl hover:shadow-emerald-500/20 hover:scale-105 text-center">
          Voir mes projets
        </a>
        <a href="mailto:votre.email@exemple.com" class="px-8 py-4 border-2 border-white/30 text-white font-semibold rounded-xl hover:bg-white/10 transition-all duration-300 backdrop-blur-sm text-center">
          Me contacter
        </a>
      </div>

      <!-- Cartes de compétences -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full max-w-5xl animate-fade-in-up">
        <div class="p-8 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 shadow-xl hover:bg-white/20 transition-all duration-300">
          <div class="text-4xl mb-4"></div>
          <h3 class="font-bold text-xl mb-3 text-white">Performance</h3>
          <p class="text-emerald-100 text-sm leading-relaxed">Architecture optimisée pour des scores Lighthouse 100/100.</p>
        </div>
        
        <div class="p-8 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 shadow-xl hover:bg-white/20 transition-all duration-300">
          <div class="text-4xl mb-4"></div>
          <h3 class="font-bold text-xl mb-3 text-white">Type Safety</h3>
          <p class="text-emerald-100 text-sm leading-relaxed">TypeScript strict et validation avec Zod.</p>
        </div>
        
        <div class="p-8 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 shadow-xl hover:bg-white/20 transition-all duration-300">
          <div class="text-4xl mb-4"></div>
          <h3 class="font-bold text-xl mb-3 text-white">Accessibilité</h3>
          <p class="text-emerald-100 text-sm leading-relaxed">HTML sémantique et normes WCAG.</p>
        </div>
      </div>

    </div>
  </div>

</BaseLayout>