---
// src/pages/projets/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Récupère tous les projets, triés par date (du plus récent au plus ancien)
const projets = await getCollection('projets');
projets.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projets | Portfolio Senior JS">
  <section class="mb-12">
    <h1 class="text-4xl font-bold text-slate-900 mb-4">Études de cas</h1>
    <p class="text-lg text-slate-600 max-w-2xl">
      Une sélection de projets mettant en avant des défis techniques, des choix d'architecture et des résultats mesurables.
    </p>
  </section>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {projets.map((projet) => (
      <a 
        href={`/projets/${projet.slug}`} 
        class="group block p-6 bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300"
      >
        <div class="flex flex-wrap gap-2 mb-4">
          {projet.data.tags.map((tag) => (
            <span class="px-2 py-1 text-xs font-semibold bg-blue-50 text-blue-700 rounded-full">
              {tag}
            </span>
          ))}
        </div>
        
        <h2 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-blue-600 transition-colors">
          {projet.data.title}
        </h2>
        
        <p class="text-slate-600 text-sm mb-4 line-clamp-3">
          {projet.data.description}
        </p>

        <div class="flex flex-wrap gap-2 mt-auto">
          {projet.data.stack.map((tech) => (
            <span class="text-xs text-slate-500 bg-slate-100 px-2 py-1 rounded">
              {tech}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>