---
// src/pages/services.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    icon: 'code',
    title: 'Web Development',
    description: 'Lorem, ipsum dolor sit amet consectetur adipisicing elit. Similique blanditiis laudantium at repudiandae corporis magni libero doloremque earum porro autem, nemo quod recusandae officiis molestias.',
  },
  {
    icon: 'design',
    title: 'UI/UX Design',
    description: 'Lorem, ipsum dolor sit amet consectetur adipisicing elit. Similique blanditiis laudantium at repudiandae corporis magni libero doloremque earum porro autem, nemo quod recusandae officiis molestias.',
  },
  {
    icon: 'mobile',
    title: 'App Development',
    description: 'Lorem, ipsum dolor sit amet consectetur adipisicing elit. Similique blanditiis laudantium at repudiandae corporis magni libero doloremque earum porro autem, nemo quod recusandae officiis molestias.',
  }
];
---

<BaseLayout title="Services | MARA - Développeur Full Stack">
  
  <!-- Page Services avec fond teal clair et marges négatives pour couvrir toute la largeur -->
  <div class="min-h-screen bg-gradient-to-br from-[#e0f2f1] via-[#b2dfdb] to-[#80cbc4] -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-7xl mx-auto">
      
      <!-- En-tête de la page -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-extrabold text-[#004d40] mb-4">
          Mes Services
        </h1>
        <p class="text-lg text-[#00695c] max-w-2xl mx-auto">
          Des solutions complètes pour donner vie à vos projets digitaux
        </p>
      </div>

      <!-- Grille de services -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        {services.map((service) => (
          <div class="bg-[#e0f7fa] rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-[#b2ebf2]">
            
            <!-- Icône agrandie (comme sur la capture) -->
            <div class="flex justify-center mb-6">
              {service.icon === 'code' && (
                <svg className="w-32 h-32 text-slate-900" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
                </svg>
              )}
              {service.icon === 'design' && (
                <svg className="w-32 h-32 text-slate-900" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />
                </svg>
              )}
              {service.icon === 'mobile' && (
                <svg className="w-32 h-32 text-slate-900" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                </svg>
              )}
            </div>

            <!-- Titre -->
            <h3 class="text-2xl font-bold text-[#004d40] mb-4 text-center">
              {service.title}
            </h3>

            <!-- Description -->
            <p class="text-[#00695c] text-center mb-6 leading-relaxed">
              {service.description}
            </p>

            <!-- Bouton Read More -->
            <div class="flex justify-center">
              <button class="px-6 py-3 bg-[#00796B] text-white font-semibold rounded-lg hover:bg-[#00695C] transition-all duration-300 shadow-md hover:shadow-lg">
                Read More
              </button>
            </div>

          </div>
        ))}

      </div>

      <!-- Section CTA -->
      <div class="mt-20 text-center">
        <h2 class="text-3xl font-bold text-[#004d40] mb-4">
          Prêt à démarrer votre projet ?
        </h2>
        <p class="text-lg text-[#00695c] mb-8">
          Contactez-moi pour discuter de vos besoins
        </p>
        <a href="mailto:votre.email@exemple.com" class="inline-block px-8 py-4 bg-[#00796B] text-white font-bold rounded-xl hover:bg-[#00695C] transition-all duration-300 shadow-lg hover:shadow-xl">
          Me contacter
        </a>
      </div>

    </div>
  </div>

</BaseLayout>