---
// src/pages/services.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    icon: 'code',
    title: 'Web Development',
    description: 'Lorem, ipsum dolor sit amet consectetur adipisicing elit. Similique blanditiis laudantium at repudiandae corporis magni libero doloremque earum porro autem, nemo quod recusandae officiis molestias.',
    color: 'text-[#00796B]'
  },
  {
    icon: 'design',
    title: 'UI/UX Design',
    description: 'Lorem, ipsum dolor sit amet consectetur adipisicing elit. Similique blanditiis laudantium at repudiandae corporis magni libero doloremque earum porro autem, nemo quod recusandae officiis molestias.',
    color: 'text-[#00796B]'
  },
  {
    icon: 'mobile',
    title: 'App Development',
    description: 'Lorem, ipsum dolor sit amet consectetur adipisicing elit. Similique blanditiis laudantium at repudiandae corporis magni libero doloremque earum porro autem, nemo quod recusandae officiis molestias.',
    color: 'text-[#00796B]'
  }
];
---

<BaseLayout title="Services | MARA - Développeur Full Stack">
  
  <!-- Page Services avec fond teal clair -->
  <div class="min-h-screen bg-gradient-to-br from-[#e0f2f1] via-[#b2dfdb] to-[#80cbc4] py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- En-tête de la page -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-extrabold text-[#004d40] mb-4">
          Mes Services
        </h1>
        <p class="text-lg text-[#00695c] max-w-2xl mx-auto">
          Des solutions complètes pour donner vie à vos projets digitaux
        </p>
      </div>

      <!-- Grille de services -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        {services.map((service) => (
          <div class="bg-[#e0f7fa] rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-[#b2ebf2]">
            
            <!-- Icône -->
            <div class="flex justify-center mb-6">
              {service.icon === 'code' && (
                <svg className="w-16 h-16 text-[#00796B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              )}
              {service.icon === 'design' && (
                <svg className="w-16 h-16 text-[#00796B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
              )}
              {service.icon === 'mobile' && (
                <svg className="w-16 h-16 text-[#00796B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
              )}
            </div>

            <!-- Titre -->
            <h3 class="text-2xl font-bold text-[#004d40] mb-4 text-center">
              {service.title}
            </h3>

            <!-- Description -->
            <p class="text-[#00695c] text-center mb-6 leading-relaxed">
              {service.description}
            </p>

            <!-- Bouton Read More -->
            <div class="flex justify-center">
              <button class="px-6 py-3 bg-[#00796B] text-white font-semibold rounded-lg hover:bg-[#00695C] transition-all duration-300 shadow-md hover:shadow-lg">
                Read More
              </button>
            </div>

          </div>
        ))}

      </div>

      <!-- Section CTA -->
      <div class="mt-20 text-center">
        <h2 class="text-3xl font-bold text-[#004d40] mb-4">
          Prêt à démarrer votre projet ?
        </h2>
        <p class="text-lg text-[#00695c] mb-8">
          Contactez-moi pour discuter de vos besoins
        </p>
        <a href="mailto:votre.email@exemple.com" class="inline-block px-8 py-4 bg-[#00796B] text-white font-bold rounded-xl hover:bg-[#00695C] transition-all duration-300 shadow-lg hover:shadow-xl">
          Me contacter
        </a>
      </div>

    </div>
  </div>

</BaseLayout>